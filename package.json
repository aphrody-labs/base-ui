{
  "name": "@base-ui/monorepo",
  "version": "1.8.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs",
    "test",
    "test/*",
    "scripts/*",
    "playground/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "nx",
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "@mui/internal-code-infra@0.1.1-canary.6": "patches/@mui%2Finternal-code-infra@0.1.1-canary.6.patch"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "form-data": "^4.0.6",
    "fast-uri": "^4.2.1",
    "ip-address": "^10.7.2",
    "js-yaml@4": "^5.4.2",
    "nanoid@3": "^6.0.1",
    "nx": "~23.2.1",
    "piscina": "^5.3.2",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "sigstore": "^5.0.0",
    "tar": "^7.5.22",
    "ws": "^8.22.0"
  },
  "scripts": {
    "deduplicate": "bun install",
    "build": "lerna run --no-private build",
    "build:fast": "bun ./scripts/aphrody/fast-build.ts",
    "release:version": "lerna version --no-changelog --no-push --no-git-tag-version --no-private",
    "release:build": "bun run docs:generate-llms && cross-env BASE_UI_PUBLISH_DOCS=1 lerna run --concurrency 8 --no-private build --skip-nx-cache --",
    "release:changelog": "code-infra generate-changelog",
    "release:changelog:docs": "FORMAT=docs code-infra generate-changelog",
    "release:publish": "code-infra publish --github-release",
    "release:publish:dry-run": "code-infra publish --github-release --dry-run ",
    "docs:api": "bun run --filter docs internal-validate --command \"bun run docs:validate\" --types",
    "docs:build": "bun run --filter docs generate-llms && bun run --filter docs build && bun run playground:build:export",
    "docs:deploy": "bun run --filter docs deploy",
    "docs:dev": "bun run --filter docs dev",
    "docs:size-why": "cross-env DOCS_STATS_ENABLED=true bun run docs:build",
    "docs:start": "bun run --filter docs serve",
    "playground:build:export": "cross-env PLAYGROUND_BASE=/vite-playground/ PLAYGROUND_OUT_DIR=../../docs/export/vite-playground bun run --cwd playground/vite-app build",
    "docs:link-check": "bun run --filter docs link-check",
    "docs:generate-llms": "bun run --filter docs generate-llms",
    "docs:infra": "bun run --filter docs docs-infra",
    "docs:validate": "bun run --filter docs internal-validate --command \"bun run docs:validate\"",
    "extract-error-codes": "code-infra extract-error-codes --errorCodesPath docs/src/error-codes.json --detection opt-out",
    "eslint": "bun run test:lint-rules && bun run --filter '*' --if-present lint && eslint . --cache --report-unused-disable-directives --max-warnings 0",
    "eslint:ci": "bun run test:lint-rules && bun run --filter '*' --if-present lint && eslint . --report-unused-disable-directives --max-warnings 0",
    "stylelint": "stylelint --reportInvalidScopeDisables --reportNeedlessDisables \"docs/**/*.{js,ts,tsx}\" \"**/*.css\" --ignore-path .lintignore",
    "vale:fix": "bun run valelint --auto-fix all",
    "valelint": "bun run code-infra vale sync --vale-version $npm_package_config_valeVersion && git ls-files | grep -E \"\\.(md|mdx)$\" | xargs bun run code-infra vale --vale-version $npm_package_config_valeVersion --filter='.Level==\"error\"'",
    "prettier": "pretty-quick --ignore-path .lintignore --branch master",
    "prettier:all": "prettier --write . --ignore-path .lintignore",
    "size:snapshot": "bun run --cwd ./test/bundle-size check",
    "size:why": "bun run size:snapshot --analyze",
    "start": "bun install && bun run docs:dev",
    "test": "bun test",
    "test:e2e": "cross-env NODE_ENV=production bun run test:e2e:build && concurrently --success first --kill-others \"bun run test:e2e:run\" \"bun run test:e2e:server\"",
    "test:e2e:build": "vite build --config test/e2e/vite.config.mjs",
    "test:e2e:dev": "vite --config test/e2e/vite.config.mjs -l info --port 5173",
    "test:e2e:run": "cross-env VITEST_ENV=chromium vitest run --project e2e",
    "test:e2e:server": "serve test/e2e -p 5173",
    "test:regressions": "cross-env NODE_ENV=production bun run test:regressions:build && concurrently --success first --kill-others \"bun run test:regressions:run\" \"bun run test:regressions:server\"",
    "test:regressions:build": "vite build --config test/regressions/vite.config.mjs",
    "test:regressions:dev": "vite --config test/regressions/vite.config.mjs --port 5173",
    "test:regressions:run": "cross-env VITEST_ENV=chromium vitest run --project regressions",
    "test:regressions:server": "serve test/regressions -p 5173",
    "pretest:screen-reader": "guidepup install",
    "test:screen-reader": "playwright test --config test/screen-reader/playwright.config.ts",
    "test:screen-reader:setup": "guidepup setup",
    "test:_unit": "cross-env TZ=UTC vitest --project @base-ui/react --project @base-ui/utils --project docs",
    "test:jsdom": "bun test",
    "test:lint-rules": "bun scripts/eslint/testRules.test.mjs",
    "test:jsdom:coverage": "bun test --coverage",
    "test:chromium": "cross-env VITEST_ENV=chromium bun run test:_unit",
    "test:chromium:ui": "bun run test:chromium --browser.headless=false",
    "test:firefox": "cross-env VITEST_ENV=firefox bun run test:_unit",
    "test:firefox:ui": "bun run test:firefox --browser.headless=false",
    "test:webkit": "cross-env VITEST_ENV=webkit bun run test:_unit",
    "test:webkit:ui": "bun run test:webkit --browser.headless=false",
    "test:browsers": "cross-env VITEST_ENV=all-browsers bun run test:_unit",
    "test:argos": "code-infra argos-push --folder test/regressions/screenshots/chrome",
    "typescript": "tsc -b tsconfig.json",
    "types:check": "bun run --filter @base-ui/react build && bun run --filter @base-ui/react types:check",
    "inline-scripts": "bun ./scripts/inlineScripts.mts",
    "test:benchmark": "bun run --cwd ./test/performance benchmark",
    "use-react-18": "code-infra set-version-overrides --pkg react@18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/plugin-transform-react-constant-elements": "8.0.5",
    "@base-ui/monorepo-tests": "workspace:*",
    "@guidepup/guidepup": "0.34.0",
    "@guidepup/playwright": "0.19.1",
    "@guidepup/setup": "0.29.1",
    "@happy-dom/global-registrator": "20.14.6",
    "@microsoft/api-extractor": "7.59.3",
    "@mui/internal-code-infra": "0.1.1-canary.6",
    "@mui/internal-netlify-cache": "0.1.1-canary.1",
    "@mui/internal-test-utils": "2.1.1-canary.2",
    "@netlify/types": "3.0.0",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-istanbul": "5.0.2",
    "@vitest/ui": "5.0.2",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "docs": "workspace:^",
    "eslint": "10.11.0",
    "globby": "16.2.4",
    "jsdom": "27.4.0",
    "lerna": "10.0.1",
    "pkg-pr-new": "0.0.88",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.9",
    "pretty-quick": "4.2.2",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-mdx": "3.1.1",
    "rimraf": "6.1.3",
    "serve": "14.2.6",
    "stylelint": "17.15.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "config": {
    "valeVersion": "3.24.0"
  },
  "packageManager": "bun@1.4.3-aphrody.2",
  "engines": {
    "node": ">=22.23.3"
  }
}
